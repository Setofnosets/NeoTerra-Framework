{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neoterra.local/schemas/beat.schema.json",
  "title": "Neo Terra Canon Beat",
  "description": "A canon milestone whose function must be landed in some form. Deadlines are soft and always carry a declared consequence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "order",
    "title",
    "description",
    "act",
    "conditions",
    "completion",
    "flexibility",
    "deadlineTurns",
    "deadlineDate",
    "deadlineConsequence",
    "rewriteHints"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$",
      "description": "Season-scoped beat id, e.g. s1.opening.arms-deal."
    },
    "order": { "type": "integer", "minimum": 0 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "act": {
      "type": "string",
      "enum": ["opening", "escalation", "climax", "resolution"]
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "turnRange": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "minItems": 2,
          "maxItems": 2
        },
        "dateRange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        "locationIds": { "type": "array", "items": { "type": "string" } },
        "actorIds": { "type": "array", "items": { "type": "string" } },
        "threatStage": { "type": "integer", "minimum": 0 },
        "requiresBeats": { "type": "array", "items": { "type": "string" } },
        "forbidsBeats": { "type": "array", "items": { "type": "string" } }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "predicates"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["event", "state", "relationship", "threat", "transformation"]
        },
        "predicates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "event-tag",
                  "character-status",
                  "location-control",
                  "threat-stage",
                  "relationship-affinity",
                  "form-active",
                  "beat-resolved",
                  "flag"
                ]
              },
              "characterId": { "type": "string" },
              "statuses": { "type": "array", "items": { "type": "string" } },
              "locationId": { "type": "string" },
              "factionId": { "type": "string" },
              "threatId": { "type": "string" },
              "stage": { "type": "integer", "minimum": 0 },
              "tag": { "type": "string" },
              "a": { "type": "string" },
              "b": { "type": "string" },
              "minAffinity": { "type": "number", "minimum": -100, "maximum": 100 },
              "formId": { "type": "string" },
              "beatId": { "type": "string" },
              "flag": { "type": "string" },
              "value": {}
            }
          }
        }
      }
    },
    "flexibility": {
      "type": "string",
      "enum": ["strict", "adaptable", "optional"]
    },
    "deadlineTurns": { "type": ["integer", "null"], "minimum": 0 },
    "deadlineDate": { "type": ["string", "null"] },
    "deadlineConsequence": { "type": "string", "minLength": 1 },
    "rewriteHints": { "type": "string", "minLength": 1 }
  }
}
